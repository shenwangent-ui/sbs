rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidShenwangAccount(data) {
      return data.keys().hasAll(['uid', 'displayName', 'identifier'])
        && data.keys().hasOnly(['uid', 'displayName', 'identifier'])
        && data.uid is string
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.identifier is string
        && data.identifier.size() >= 3 && data.identifier.size() <= 160;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidShenwangAccount(incoming())
        && incoming().uid == userId;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidShenwangAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'identifier']);
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
